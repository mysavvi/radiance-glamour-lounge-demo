{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neo Social Media Card",
  "type": "object",
  "required": ["businessName", "title", "handle", "social"],
  "properties": {
    "businessName": { "type": "string" },
    "title": { "type": "string" },
    "handle": { "type": "string" },
    "caption": { "type": "string" },
    "cta": { "type": "string" },
    "media": {
      "type": "object",
      "properties": {
        "background": { "type": "string" },
        "backgroundPosition": { "type": "string" },
        "avatar": { "type": "string" },
        "avatarPosition": { "type": "string" }
      }
    },
    "social": {
      "type": "object",
      "properties": {
        "tiktok": { "type": "string", "format": "uri" },
        "instagram": { "type": "string", "format": "uri" },
        "facebook": { "type": "string", "format": "uri" },
        "youtube": { "type": "string", "format": "uri" },
        "googleReview": { "type": "string", "format": "uri" }
      }
    },
    "socialIconBase": { "type": "string" },
    "stats": {
      "type": "object",
      "properties": {
        "viewers": { "type": "number" },
        "hearts": { "type": "number" },
        "comments": { "type": ["number", "string"] },
        "bookmarks": { "type": ["number", "string"] },
        "shares": { "type": ["number", "string"] }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "text"],
        "properties": {
          "name": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "reviewsUrl": { "type": "string" }
  }
}
